---
import { Image } from './icons';
import type { Picture } from '../data/media';
interface Props { pictures: Picture[]; featured?: boolean; empty?: string }
const { pictures, featured = false, empty } = Astro.props;
---
{pictures.length ? (
  <>
    <div class:list={['gallery', { 'gallery-featured': featured }]}>
      {pictures.map((pic, index) => (
        <a href={pic.full || pic.src} target="_blank" rel="noopener" data-expand-image aria-label={`Ampliar: ${pic.alt}`}>
          <img src={pic.src} srcset={pic.srcset}
            sizes={featured && index === 0 ? '(min-width: 1376px) 1280px, 94vw' :
              featured ? '(max-width: 760px) 47vw, 427px' : '(max-width: 650px) 100vw, 380px'}
            width={pic.width} height={pic.height} alt={pic.alt} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
    <dialog class="image-dialog" aria-label="Imagen ampliada">
      <form method="dialog"><button class="button" aria-label="Cerrar imagen">Cerrar</button></form>
      <img alt="" />
    </dialog>
  </>
) : empty && (
  <div class="gallery-empty">
    <Image size={36} stroke-width={1.45} aria-hidden="true" />
    <p>{empty}</p>
  </div>
)}
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-expand-image]').forEach(link => {
    link.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const dialog = link.closest('.gallery')?.nextElementSibling;
      if (!(dialog instanceof HTMLDialogElement)) return;
      const enlarged = dialog.querySelector('img');
      const thumbnail = link.querySelector('img');
      if (!enlarged || !thumbnail) return;
      event.preventDefault();
      enlarged.src = link.href;
      enlarged.alt = thumbnail.alt;
      dialog.showModal();
    });
  });
</script>
