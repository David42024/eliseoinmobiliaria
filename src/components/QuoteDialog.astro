---
import QuoteEmailForm from './QuoteEmailForm.astro';
import SocialIcon from './SocialIcon.astro';
import { project, salesMessage, wap } from '../data/project';
---
<dialog class="quote-dialog" id="cotizacion-en-pagina" aria-labelledby="cotizacion-en-pagina-titulo">
  <header>
    <h2 id="cotizacion-en-pagina-titulo">Solicita una cotización</h2>
    <button class="button outline compact" type="button" data-quote-close>Cerrar</button>
  </header>
  <p data-quote-dialog-interest>{project.name}</p>
  <QuoteEmailForm />
  <a class="text-link" href={wap(salesMessage('cotizacion'))} target="_blank" rel="noopener noreferrer" data-quote-whatsapp data-whatsapp>
    <SocialIcon name="whatsapp" size={19} /> Cotizar por WhatsApp
  </a>
</dialog>

<script>
  import { project, salesMessage, wap } from '../data/project';

  const dialog = document.querySelector<HTMLDialogElement>('#cotizacion-en-pagina');
  if (dialog?.showModal) {
    const title = dialog.querySelector<HTMLElement>('[data-quote-dialog-interest]')!;
    const form = dialog.querySelector<HTMLFormElement>('[data-quote-email]')!;
    const context = form.querySelector<HTMLInputElement>('[data-quote-context]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const feedback = form.querySelector<HTMLElement>('[data-quote-feedback]')!;
    const whatsapp = dialog.querySelector<HTMLAnchorElement>('[data-quote-whatsapp]')!;
    let trigger: HTMLAnchorElement | undefined;
    let previousInterest: string | undefined;

    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-quote-open]')) {
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', dialog.id);
      link.addEventListener('click', event => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const interest = link.dataset.quoteInterest || '';
        if (!submit.disabled && interest !== previousInterest) {
          if (previousInterest !== undefined) form.reset();
          context.value = interest || project.name;
          title.textContent = context.value;
          whatsapp.href = wap(salesMessage('cotizacion', interest));
          feedback.textContent = '';
          previousInterest = interest;
        }
        trigger = link;
        if (!dialog.open) {
          dialog.showModal();
          dialog.scrollTop = 0;
        }
      });
    }

    dialog.querySelector('[data-quote-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => trigger?.focus({ preventScroll: true }));
  }
</script>

<style>
  .quote-dialog {
    width: min(490px, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1rem, 4vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--white);
    color: var(--forest);
    box-shadow: 0 14px 54px #15312660;
    overscroll-behavior: contain;
  }
  .quote-dialog::backdrop { background: #12271f9a; }
  header { display: flex; align-items: start; justify-content: space-between; gap: .65rem; }
  h2 { font-size: clamp(1.55rem, 5vw, 2.3rem); }
  [data-quote-dialog-interest] { margin: .5rem 0 1rem; font-weight: 650; }
  [data-quote-whatsapp] { margin-top: 1rem; }
</style>
