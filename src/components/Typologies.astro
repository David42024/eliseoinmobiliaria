---
import { Building, House, PanelsTopLeft } from './icons';
import CardMedia from './CardMedia.astro';
import QuoteAction from './QuoteAction.astro';
import { project, typologyPath } from '../data/project';
import { publicPrice, priceDetails, priceLabel } from '../data/commercial';
import { media, type Picture } from '../data/media';
const { expanded = false } = Astro.props;
const icons = { lot: PanelsTopLeft, apartment: Building, house: House };
const references = {
  lot: { src: '/tipologias/lotes.webp', alt: 'Terrenos residenciales junto a una vía pavimentada' },
  apartment: { src: '/tipologias/departamentos.webp', alt: 'Edificios de departamentos junto a un jardín' },
  house: { src: '/tipologias/casas.webp', alt: 'Casas de dos pisos dentro de un conjunto residencial' },
};
---
<div class="type-grid">
  {project.typologies.map(type => {
    const Icon = icons[type.icon];
    const detail = media.typologies[type.id];
    const supplied = detail?.cardImage ?? detail?.renders?.[0];
    const image: Picture = supplied ?? { ...references[type.icon], width: 960, height: 600 };
    const price = publicPrice('typology', type.id);
    const commercialDetails = price ? priceDetails(price) : '';
    return (
      <article class="type-card" id={expanded ? type.id : undefined}>
        <CardMedia picture={image} reference={!supplied} />
        <div class="type-copy">
          <span class="type-icon"><Icon size={23} stroke-width={1.55} /></span>
          <h3>{type.label}</h3>
          <p>{type.description}</p>
          {(detail?.area || 'area' in type) && <p class="type-area">{detail?.area || ('area' in type ? type.area : '')}</p>}
          {expanded && <p class="property-detail">{detail?.availability || 'Disponibilidad por consultar'}</p>}
          <div class="type-end">
            {price && <div class="type-price">
              <strong>{priceLabel(price)}</strong>
              {commercialDetails && <small>{commercialDetails}</small>}
            </div>}
            <div class="type-links">
              <a class="button outline compact" href={typologyPath(type)}>Ver {type.label.toLocaleLowerCase('es-PE')}</a>
              <QuoteAction class="button soft compact" type={type.id}>
                {price ? 'Cotizar inmueble' : 'Consultar precio'}<span class="sr-only"> · {type.singular}</span>
              </QuoteAction>
            </div>
          </div>
        </div>
      </article>
    );
  })}
</div>
