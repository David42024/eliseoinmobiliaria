---
import { ChevronRight, GraduationCap, Route, Trees } from '../components/icons';
import CardMedia from '../components/CardMedia.astro';
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import QuoteAction from '../components/QuoteAction.astro';
import VisitBanner from '../components/VisitBanner.astro';
import Gallery from '../components/Gallery.astro';
import { project, spacePath, typologyPath } from '../data/project';
import { media } from '../data/media';
const totalHomes = String(project.totals.homes).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const icons = { trees: Trees, education: GraduationCap, route: Route };
const spaceAlt = {
  trees: 'Sendero arbolado y bancas en un parque vecinal',
  education: 'Pabellón comunitario con una zona al aire libre para actividades',
  route: 'Calle residencial pavimentada con veredas y cruce peatonal',
};
---
<Site title="El proyecto | La Nueva Estancia · Elíseo" description="Conoce la propuesta de habilitación urbana de La Nueva Estancia en Víctor Larco, sus cifras, espacios proyectados y fecha de entrega anunciada." quoteDialog>
  <PageIntro title="La Nueva Estancia" section="Proyecto" description="Una habilitación urbana residencial frente a la Av. Huamán, en el distrito de Víctor Larco, Trujillo." />
  <section class="section wrap">
    <div class="section-heading">
      <div><p class="eyebrow">El desarrollo</p><h2>Qué contempla el proyecto</h2></div>
      <QuoteAction>Cotizar el proyecto</QuoteAction>
    </div>
    <div class="stats-grid">
      <div><strong>{project.totals.lots}</strong><span>Lotes</span></div>
      <div><strong>{totalHomes}</strong><span>Viviendas</span></div>
      <div><strong>{project.totals.parking}</strong><span>Estacionamientos</span></div>
    </div>
    <ul class="lot-breakdown">
      {project.typologies.map(type => (
        <li>
          <a href={typologyPath(type)}>
            <span><strong>{type.lotCount} lotes</strong> para {type.plotUse}</span>
            <ChevronRight size={19} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
    <div class="type-grid">
      {project.spaces.map(space => {
        const Icon = icons[space.icon];
        const supplied = media.spaces?.[space.slug]?.[0];
        const image = supplied ?? { src: `/espacios/${space.slug}.webp`, alt: spaceAlt[space.icon], width: 960, height: 600 };
        return (
          <article class="type-card">
            <CardMedia picture={image} reference={!supplied} />
            <div class="type-copy">
              <span class="type-icon"><Icon size={25} aria-hidden="true" /></span>
              <h3>{space.label}</h3>
              <p>{space.description}</p>
              <div class="type-end">
                <a href={spacePath(space)} class="button outline compact">
                  Ver {space.label.toLocaleLowerCase('es-PE')} <ChevronRight size={17} aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
  <section class="section wrap project-gallery">
    <h2>Galería del proyecto</h2>
    <Gallery pictures={media.gallery} featured empty="Las imágenes y renders de La Nueva Estancia se mostrarán aquí cuando estén disponibles." />
  </section>
  <section class="section location-home" id="entrega">
    <div class="wrap split">
      <div><p class="eyebrow">Etapa comercial</p><h2>Preventa sobre planos</h2></div>
      <div><p>La entrega está anunciada para <strong>{project.delivery.toLocaleLowerCase('es-PE')}</strong>. Consulta con Elíseo el estado actual del proyecto y las condiciones comerciales.</p><a class="text-link" href="/avance/">Consultar avance de obra</a></div>
    </div>
  </section>
  <VisitBanner />
</Site>
