---
import type { InferGetStaticPropsType } from 'astro';
import { Building, House, PanelsTopLeft } from '../../components/icons';
import Gallery from '../../components/Gallery.astro';
import PageIntro from '../../components/PageIntro.astro';
import QuoteAction from '../../components/QuoteAction.astro';
import Site from '../../layouts/Site.astro';
import { project, typologyPath } from '../../data/project';
import { priceLabel, publicPrice } from '../../data/commercial';
import { media } from '../../data/media';

export function getStaticPaths() {
  return project.typologies.map(type => ({ params: { tipologia: type.slug }, props: { type } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { type } = Astro.props;
const details = media.typologies[type.id];
const area = details?.area || ('area' in type ? type.area : undefined);
const pictures = [...(details?.renders || []), ...(details?.floorPlan ? [details.floorPlan] : [])];
const price = publicPrice('typology', type.id);
const Icon = { lot: PanelsTopLeft, apartment: Building, house: House }[type.icon];
---
<Site title={`${type.label} en Víctor Larco | La Nueva Estancia · Elíseo`} description={`${type.description} Consulta precio y disponibilidad en La Nueva Estancia, Víctor Larco.`} quoteDialog>
  <PageIntro title={type.label} section={type.label} description={type.description} parent={{ label: 'Tipologías', href: '/tipologias/' }} />
  <section class="section wrap detail-layout">
    <div class="detail-copy">
      <h2>{type.detailHeading}</h2>
      <p>{type.detail}</p>
      <div class="button-row">
        <QuoteAction type={type.id}>Solicitar cotización</QuoteAction>
        {type.icon === 'lot'
          ? <a class="text-link" href="/tipologias/#visor">Abrir el visor de lotes</a>
          : <a class="text-link" href="/ubicacion/">Ver ubicación del proyecto</a>}
      </div>
    </div>
    <aside class="detail-panel" aria-labelledby="datos-tipologia">
      <span class="type-icon"><Icon size={27} stroke-width={1.45} aria-hidden="true" /></span>
      <h2 id="datos-tipologia">Datos de la tipología</h2>
      <dl class="detail-facts">
        <div><dt>Lotes para {type.plotUse}</dt><dd>{type.lotCount} proyectados</dd></div>
        {area && <div><dt>Superficie</dt><dd>{area}</dd></div>}
        {type.icon !== 'lot' && details?.bedrooms && <div><dt>Dormitorios</dt><dd>{details.bedrooms}</dd></div>}
        {type.icon !== 'lot' && details?.bathrooms && <div><dt>Baños</dt><dd>{details.bathrooms}</dd></div>}
        <div><dt>Disponibilidad</dt><dd>{details?.availability || 'Por consultar'}</dd></div>
        <div><dt>Precio</dt><dd>{price ? priceLabel(price) : <QuoteAction class="button soft compact" type={type.id}>Consultar precio</QuoteAction>}</dd></div>
      </dl>
    </aside>
    <section class="detail-gallery">
      <h2>Imágenes de la tipología</h2>
      <Gallery pictures={pictures} featured empty="Los renders y planos se mostrarán aquí cuando estén disponibles." />
    </section>
  </section>
  <section class="related-section"><div class="wrap">
    <h2>Otras tipologías</h2>
    <ul class="related-links">
      {project.typologies.filter(other => other.id !== type.id).map(other => <li><a class="button outline" href={typologyPath(other)}>{other.label}</a></li>)}
    </ul>
  </div></section>
</Site>
