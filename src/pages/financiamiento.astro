---
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import LeadForm from '../components/LeadForm.astro';
import { ChevronRight } from '../components/icons';
import { dollars, financing, publicAdjustments, publicStages } from '../data/commercial';
const locations: Record<string, string> = { parque: 'Frente a parque', esquina: 'Esquina', avenida: 'Avenida' };
---
<Site title="Financiamiento y cotizador | La Nueva Estancia · Elíseo" description="Solicita una cotización de La Nueva Estancia y consulta con Elíseo las condiciones de pago vigentes.">
  <PageIntro title="Financiamiento y cotizador" section="Financiamiento" description="Consulta el precio y las condiciones de pago de la tipología o lote que te interesa." />
  <section class="section wrap commercial-layout">
    <LeadForm mode="quote" />
    <section class="commercial-panel payment-panel" aria-labelledby="payment-title">
      <p class="eyebrow">Condiciones de compra</p><h2 id="payment-title">Opciones de pago</h2>
      {financing.modalities.length ? <ul class="nearby-list">{financing.modalities.map(option => <li><div><strong>{option.label}</strong><p>{option.description}</p></div></li>)}</ul> :
        <p>El equipo comercial puede orientarte sobre las condiciones vigentes y ayudarte a solicitar una simulación.</p>}
      {financing.initial !== null && <p>Cuota inicial de referencia: <strong>{financing.initial} %</strong>.</p>}
      <a class="button outline" href="/tipologias/#visor">Explorar lotes <ChevronRight size={17} aria-hidden="true" /></a>
    </section>
  </section>
  {(publicStages.length > 0 || publicAdjustments.length > 0) && <section class="section wrap commercial-reference">
    {publicStages.length > 0 && <div>
      <h2>Precios por tramo</h2>
      <div class="commercial-table" role="region" aria-label="Precios por tramo" tabindex="0">
        <table>
          <thead><tr><th scope="col">Tramo</th><th scope="col">Lote por m²</th><th scope="col">Lote de 162 m²</th><th scope="col">Departamento por m²</th></tr></thead>
          <tbody>{publicStages.map(stage => <tr>
            <th scope="row">{stage.name}</th><td>{dollars(stage.lotPerM2)}</td>
            <td>{dollars(stage.lotPerM2 * 162)}</td><td>{dollars(stage.apartmentPerM2)}</td>
          </tr>)}</tbody>
        </table>
      </div>
    </div>}
    {publicAdjustments.length > 0 && <div>
      <h2>Incrementos por ubicación</h2>
      <ul class="nearby-list">{publicAdjustments.map(record => <li>{locations[record.location] || record.location} <strong>+{record.percent} %</strong></li>)}</ul>
    </div>}
  </section>}
</Site>

<style>
  .payment-panel .button { margin-top: 1.15rem; }
  .commercial-reference { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .commercial-table { overflow: auto; margin-top: 1rem; border: 1px solid var(--line); border-radius: 12px; }
  .commercial-table table { width: 100%; border-collapse: collapse; text-align: left; }
  .commercial-table th, .commercial-table td { padding: .65rem .85rem; border-bottom: 1px solid var(--line); }
  .commercial-table thead { background: var(--soft); }
  .commercial-table td { white-space: nowrap; }
  .commercial-table tbody tr:last-child > * { border-bottom: 0; }
</style>
