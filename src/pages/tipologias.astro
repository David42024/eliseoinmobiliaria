---
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import Typologies from '../components/Typologies.astro';
import LotViewer from '../components/LotViewer.astro';
import { project, salesMessage, typologyPath, wap } from '../data/project';
import { inventory, demo } from '../data/inventory';
import { publicPrice, priceLabel } from '../data/commercial';
---
<Site title="Tipologías y visor de lotes | La Nueva Estancia · Elíseo" description="Conoce las tres tipologías de La Nueva Estancia y consulta superficie, precio y disponibilidad de lotes en Víctor Larco.">
  <PageIntro title="Tipologías y visor de lotes" section="Tipologías" description="Explora las opciones de vivienda de La Nueva Estancia y consulta disponibilidad con un asesor." />
  <section class="section wrap">
    <h2 class="sr-only">Tipologías del proyecto</h2>
    <Typologies expanded />
    {publicPrice('parking', 'estacionamiento') && <p class="lot-breakdown">Estacionamientos · {priceLabel(publicPrice('parking', 'estacionamiento'))}</p>}
  </section>
  <section class="section location-home" id="visor"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">Plano maestro</p><h2>Visor de lotes</h2></div></div>
    {inventory ? <LotViewer plan={inventory} isDemo={inventory === demo} /> : (
      <div class="empty-panel">
        <h3>Consulta los lotes del proyecto</h3>
        <p>El plano maestro y el inventario vigente aún no están disponibles en línea. Un asesor puede orientarte sobre las opciones de {project.name}.</p>
        <div class="button-row">
          <a class="button" data-whatsapp href={wap(salesMessage('informacion', 'los lotes unifamiliares'))} target="_blank" rel="noopener noreferrer">Consultar disponibilidad</a>
          <a class="text-link" href={typologyPath(project.typologies[0])}>Ver lotes unifamiliares</a>
        </div>
      </div>
    )}
  </div></section>
</Site>
