---
import { Building, CalendarDays, ChevronRight, MapPin } from '../components/icons';
import Site from '../layouts/Site.astro';
import Gallery from '../components/Gallery.astro';
import ProjectMap from '../components/ProjectMap.astro';
import QuoteAction from '../components/QuoteAction.astro';
import Typologies from '../components/Typologies.astro';
import VisitBanner from '../components/VisitBanner.astro';
import { project, spacePath } from '../data/project';
import { priceLabel, publicPrice } from '../data/commercial';
import { media } from '../data/media';
const price = publicPrice('project', project.id);
---
<Site title="La Nueva Estancia en Víctor Larco | Elíseo Inmobiliaria" description="Explora lotes, departamentos y casas de La Nueva Estancia, un proyecto en preventa frente a la Av. Huamán, Víctor Larco, Trujillo." quoteDialog>
  <section class:list={['hero', { 'hero-with-photo': media.cover }]}>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span></span> Preventa sobre planos</p>
        <h1>La Nueva Estancia <em>en Víctor Larco</em></h1>
        <p class="hero-description">Lotes, departamentos y casas en un proyecto residencial frente a la Av. Huamán, Trujillo.</p>
        {price && <p class="hero-price">{priceLabel(price)}</p>}
        <div class="button-row">
          <a href="/tipologias/#visor" class="button light">Explorar lotes</a>
          <a href="/contacto/?finalidad=visita" class="button on-dark">Solicitar visita</a>
          <QuoteAction class="button on-dark">{price ? 'Solicitar cotización' : 'Consultar precio'}</QuoteAction>
        </div>
      </div>
      {media.cover ? (
        <img class="hero-photo" src={media.cover.src} srcset={media.cover.srcset} sizes="(max-width: 760px) 100vw, 50vw" width={media.cover.width} height={media.cover.height} alt={media.cover.alt} fetchpriority="high" />
      ) : (
        <div class="hero-art" aria-hidden="true">
          <div class="art-grid"></div>
          <div class="art-arch arch-one"></div><div class="art-arch arch-two"></div><div class="art-arch arch-three"></div>
          <div class="art-arch arch-four"></div><div class="art-arch arch-five"></div>
          <div class="art-axis"></div><div class="art-cross cross-top"></div><div class="art-cross cross-bottom"></div>
          <img src="/marca/simbolo-claro.webp" width="440" height="391" alt="" />
        </div>
      )}
    </div>
  </section>
  <section class="factbar" aria-label="Datos del proyecto">
    <div class="wrap fact-grid">
      <a href="/ubicacion/"><MapPin aria-hidden="true" /><span><small>Ubicación</small><strong>Av. Huamán, Víctor Larco</strong></span><ChevronRight class="fact-arrow" aria-hidden="true" /></a>
      <a href="/proyecto/"><Building aria-hidden="true" /><span><small>Habilitación urbana</small><strong>{project.totals.lots} lotes proyectados</strong></span><ChevronRight class="fact-arrow" aria-hidden="true" /></a>
      <a href="/proyecto/#entrega"><CalendarDays aria-hidden="true" /><span><small>Entrega anunciada</small><strong>{project.delivery}</strong></span><ChevronRight class="fact-arrow" aria-hidden="true" /></a>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <div><p class="eyebrow">Tipologías</p><h2>Encuentra tu espacio</h2></div>
      <a class="text-link" href="/tipologias/">Ver todas las tipologías</a>
    </div>
    <Typologies />
  </section>
  {media.gallery.length > 0 && <section class="section wrap home-gallery"><h2>Imágenes de La Nueva Estancia</h2><Gallery pictures={media.gallery} featured /></section>}
  <section class="section location-home">
    <div class="wrap split">
      <ProjectMap />
      <div>
        <p class="eyebrow">Ubicación</p>
        <h2>Frente a la Av. Huamán</h2>
        <p>En Víctor Larco, cerca del óvalo La Marina y con conexión a las principales vías de Trujillo.</p>
        <p>La propuesta urbana contempla servicios, parques y áreas verdes, además de espacios de recreación y educación.</p>
        <div class="button-row"><a class="button" href="/ubicacion/">Ver ubicación</a><a class="button outline" href={spacePath(project.spaces[0])}>Ver parques y áreas verdes</a></div>
      </div>
    </div>
  </section>
  <VisitBanner />
</Site>
