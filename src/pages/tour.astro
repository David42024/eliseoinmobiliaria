---
import { ScanLine } from '../components/icons';
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import TourPlayer from '../components/TourPlayer.astro';
import Gallery from '../components/Gallery.astro';
import { media } from '../data/media';
---
<Site title="Tour virtual 360° | La Nueva Estancia · Elíseo" description="Recorre la sala, el comedor, la cocina, los dormitorios y los baños de un departamento de La Nueva Estancia en 360°.">
  <PageIntro title="Tour virtual 360°" section="Tour 360°" description="Explora los interiores de un departamento de La Nueva Estancia." />
  <section class="section wrap" id="departamento">
    {media.tour ? (
      <>
        <div class="section-heading">
          <div>
            <h2>Recorrido del departamento</h2>
            <p>Sala, comedor, cocina y vistas de dormitorios y baños.</p>
          </div>
          <a class="text-link" href="/tipologias/departamentos/">Ver ficha del departamento</a>
        </div>
        <TourPlayer tour={media.tour} tracking />
      </>
    ) : (
      <div class="empty-panel tour-empty">
        <span class="type-icon"><ScanLine size={30} /></span>
        <h2>Recorrido virtual en preparación</h2>
        <p>Mientras se prepara el recorrido, puedes consultar las tipologías y conocer las novedades del proyecto.</p>
        <div class="button-row"><a class="button" href="/tipologias/#visor">Explorar lotes</a><a class="text-link" href="/avance/">Ver avance de obra</a></div>
      </div>
    )}
    {media.gallery.length > 0 && <div class="section-inline"><h2>Galería del proyecto</h2><Gallery pictures={media.gallery} /></div>}
    {media.model && <div class="section-inline"><h2>Maqueta digital</h2><TourPlayer tour={media.model} label="Explorar maqueta" /></div>}
  </section>
</Site>
